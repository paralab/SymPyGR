/**
 * @file {{ project_name }}_lts_driver.h
 * @brief Local-time-stepping driver for the {{ project_name }} solver.
 *
 * Generated by dendrosym. Used when [solver] time_stepper = "lts". The stepper,
 * the event clock, the g carry and its file format are dendrolib's
 * (docs/lts_solver_contract.md); this file only calls them. Library names come
 * from dendrosym/lts_names.py. Needs a dendrolib with {{ lts.helpers_header }} and the
 * {{ lts.options }}-taking {{ lts.stepper }}.
 */

#ifndef {{ project_upper }}_LTS_DRIVER_H
#define {{ project_upper }}_LTS_DRIVER_H

#include <iostream>
#include <string>

#include <mpi.h>

#include "{{ lts.stepper_header }}"
#include "{{ lts.helpers_header }}"
#include "grDef.h"
#include "parameters.h"
#include "{{ project_name }}Ctx.h"

namespace {{ namespace }} {

/** Runs the evolution from the mesh and state in `ctx`. @return exit code */
inline int run_{{ project_name }}_lts({{ project_upper }}Ctx *ctx, MPI_Comm comm) {
    int rank;
    MPI_Comm_rank(comm, &rank);

    ts::{{ lts.options }} opts;
    opts.iface       = {{ project_upper }}_LTS_IFACE;
    opts.g_exchange  = {{ project_upper }}_LTS_G_EXCHANGE;
    opts.ratio_cap   = {{ project_upper }}_LTS_RATIO_CAP;
    if (!ts::{{ lts.options_valid }}(opts)) {
        if (rank == 0) std::cerr << "invalid [lts] options" << std::endl;
        return 1;
    }

    // the finest-level step; a remesh recomputes it in on_mesh_changed
    {{ project_upper }}_RK45_TIME_STEP_SIZE = ts::compute_cfl_dt(
        ctx->get_mesh(), {{ project_upper }}_CFL_FACTOR,
        {{ project_upper }}_COMPD_MAX[0] - {{ project_upper }}_COMPD_MIN[0],
        {{ project_upper }}_ELE_ORDER);
    ctx->set_timestep({{ project_upper }}_RK45_TIME_STEP_SIZE);

    ts::{{ lts.stepper }}<DendroScalar, {{ project_upper }}Ctx> lts(
        ctx, {{ project_upper }}_LTS_WPART, opts);
    lts.set_evolve_vars(ctx->get_evolution_vars());
    // rk_type is RK3 or RK4 here: readParamFile refuses the rest under LTS
    lts.set_ets_coefficients({{ project_upper }}_RK_TYPE == RKType::RK3
                                 ? ts::ETSType::RK3 : ts::ETSType::RK4);
    lts.init();

    if (rank == 0)
        std::cout << "LTS stepper initialized. dt_fine="
                  << {{ project_upper }}_RK45_TIME_STEP_SIZE << std::endl;

    // iface 15: the stage-vector history is written next to each checkpoint slot
    auto g_base = [](int slot) {
        return {{ project_upper }}_CHKPT_FILE_PREFIX + "_" + std::to_string(slot) + "_enuts_g";
    };
    const DendroIntL start_step = lts.curr_step();
    if (start_step != 0) lts.{{ lts.read_carried_g }}(g_base(ctx->restored_checkpt_slot()));

    const double time_end             = {{ project_upper }}_RK_TIME_END;
    const unsigned int io_freq        = {{ project_upper }}_IO_OUTPUT_FREQ;
    const unsigned int ts_output_freq = {{ project_upper }}_TIME_STEP_OUTPUT_FREQ;
    const unsigned int checkpt_freq   = {{ project_upper }}_CHECKPT_FREQ;
    const unsigned int remesh_freq    = {{ project_upper }}_REMESH_TEST_FREQ;
{% if enable_gw_extraction %}
    const unsigned int gw_freq        = {{ project_upper }}_GW_EXTRACT_FREQ;
{% endif %}
{% if enable_ah %}
#ifdef SOLVER_ENABLE_AH
    const unsigned int ah_freq        = AH::AH_SOLVER_FREQ;
#endif
{% endif %}

    ts::{{ lts.clock }} clk;
    clk.dt_fine = [] { return {{ project_upper }}_RK45_TIME_STEP_SIZE; };
    clk.lts     = true;
    ts::{{ lts.cadence }} cRemesh, cTerm, cIO, cChk;
{% if enable_gw_extraction %}
    ts::{{ lts.cadence }} cGW;
{% endif %}
{% if enable_ah %}
#ifdef SOLVER_ENABLE_AH
    ts::{{ lts.cadence }} cAH;
#endif
{% endif %}
    // the remesh test and the checkpoint first fire after their interval, the
    // output events at step 0
    clk.{{ lts.clock_seed }}(cRemesh, remesh_freq);
    clk.{{ lts.clock_seed }}(cChk, checkpt_freq);
    if (start_step != 0) {
        // restart: every gate starts from the first boundary after the coarse
        // step that just ended
        const double t_prev = lts.curr_time() - lts.get_dt_max();
        clk.{{ lts.clock_resume }}(cRemesh, remesh_freq, t_prev);
        clk.{{ lts.clock_resume }}(cTerm, ts_output_freq, t_prev);
        clk.{{ lts.clock_resume }}(cIO, io_freq, t_prev);
        clk.{{ lts.clock_resume }}(cChk, checkpt_freq, t_prev);
{% if enable_gw_extraction %}
        clk.{{ lts.clock_resume }}(cGW, gw_freq, t_prev);
{% endif %}
{% if enable_ah %}
#ifdef SOLVER_ENABLE_AH
        clk.{{ lts.clock_resume }}(cAH, ah_freq, t_prev);
#endif
{% endif %}
    }

    ctx->compute_constraint_variables();
    ctx->write_grid_summary_data();

    while (lts.curr_time() < time_end) {
        const DendroIntL step = lts.curr_step();
        const double time     = lts.curr_time();

        if (step != 0 && clk.{{ lts.clock_due }}(cRemesh, remesh_freq, step, time))
            ts::{{ lts.remesh_if_needed }}(
                *ctx, lts, {{ project_upper }}_DENDRO_GRAIN_SZ,
                {{ project_upper }}_LOAD_IMB_TOL, {{ project_upper }}_SPLIT_FIX);

        if (clk.{{ lts.clock_due }}(cTerm, ts_output_freq, step, time))
            ctx->terminal_output();

        if (clk.{{ lts.clock_due }}(cIO, io_freq, step, time)) {
            ctx->compute_constraint_variables();
            ctx->write_vtu();
        }
{% if enable_gw_extraction %}

        if (clk.{{ lts.clock_due }}(cGW, gw_freq, step, time))
            ctx->extract_gravitational_waves();
{% endif %}
{% if enable_ah %}
#ifdef SOLVER_ENABLE_AH

        if (clk.{{ lts.clock_due }}(cAH, ah_freq, step, time)) ctx->findAH();
#endif
{% endif %}

        lts.evolve();  // one coarse step

        if (clk.{{ lts.clock_due }}(cChk, checkpt_freq, step, time)) {
            const int slot = clk.{{ lts.clock_slot }}(checkpt_freq, time);
            ts::{{ lts.checkpoint }}(*ctx, lts, [&] {
                ctx->write_checkpt(slot);
                lts.{{ lts.write_carried_g }}(g_base(slot));
            });
        }

        ctx->prepare_for_next_iter();
    }

    ctx->compute_constraint_variables();
    ctx->write_vtu();

    if (rank == 0) {
        std::cout << "  {{ project_upper }} LTS solver complete." << std::endl;
        std::cout << "  Final step: " << lts.curr_step() << std::endl;
        std::cout << "  Final time: " << lts.curr_time() << std::endl;
    }
    return 0;
}

}  // namespace {{ namespace }}

#endif  // {{ project_upper }}_LTS_DRIVER_H
