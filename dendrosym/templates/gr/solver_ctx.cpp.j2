// What the global driver does after a remesh: the derivative workspace for the
// new block sizes, the finest-level step, the grid statistics. The mpi context
// and constraint vectors are rebuilt in grid_transfer; a relabel (remeshed =
// false) changes neither the octree nor the step.
void {{ project_upper }}Ctx::on_mesh_changed(bool remeshed) {
    {{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE = ts::realloc_deriv_workspace(
        {{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE, m_uiMesh,
        {{ namespace }}::{{ project_upper }}_NUM_DERIVATIVES);
    calculate_full_grid_size();
    if (!remeshed) return;

    {{ namespace }}::{{ project_upper }}_RK45_TIME_STEP_SIZE = ts::compute_cfl_dt(
        m_uiMesh, {{ namespace }}::{{ project_upper }}_CFL_FACTOR,
        {{ namespace }}::{{ project_upper }}_COMPD_MAX[0] -
            {{ namespace }}::{{ project_upper }}_COMPD_MIN[0],
        {{ namespace }}::{{ project_upper }}_ELE_ORDER);
    set_timestep({{ namespace }}::{{ project_upper }}_RK45_TIME_STEP_SIZE);
}

// Level offset of the step ladder. A block steps at its CFL step unless a stiff
// rate in the equations (the audit found them) bounds it lower: the bound is
// rate_c / max rate, the same on every block because the rates are parameters
// here, not fields. With no rate, only the CFL step binds.
unsigned int {{ project_upper }}Ctx::compute_lts_ts_offset() {
    unsigned int lmin, lmax;
    m_uiMesh->computeMinMaxLevel(lmin, lmax);
    const double dt_min = {{ namespace }}::{{ project_upper }}_CFL_FACTOR *
        (({{ namespace }}::{{ project_upper }}_COMPD_MAX[0] -
          {{ namespace }}::{{ project_upper }}_COMPD_MIN[0]) *
         ((1u << (m_uiMaxDepth - lmax)) /
          ((double){{ namespace }}::{{ project_upper }}_ELE_ORDER)) /
         ((double)(1u << m_uiMaxDepth)));

    double rate = 0.0;
{% for r in lts_rates %}
    rate = std::max(rate, {{ r }});
{% endfor %}
    const double dt_stable = rate > 0.0
        ? {{ namespace }}::{{ project_upper }}_LTS_RATE_C / rate
        : std::numeric_limits<double>::infinity();

    const unsigned int offset = ts::{{ lts.level_offset }}(
        *m_uiMesh, lmax, dt_min, [&](unsigned int) { return dt_stable; },
        m_uiMesh->getMPIGlobalCommunicator());
    if (m_uiMesh->isActive() && !m_uiMesh->getMPIRankGlobal())
        std::cout << "LTS offset : " << offset << std::endl;
    return offset;
}

