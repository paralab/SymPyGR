int {{ project_upper }}Ctx::post_timestep(DVec &sIn) {
    if (!m_uiMesh->isActive()) return 0;
{% if boundary_value_modes %}

    // the clock is advanced after post_timestep, so the state here is at t + dt
    this->apply_boundary_values(sIn, m_uiTinfo._m_uiT + m_uiTinfo._m_uiTh);
{% endif %}

    DendroScalar *zipIn[{{ evolution_num_vars }}];
    sIn.to_2d(zipIn);

    const unsigned int nodeLocalBegin = m_uiMesh->getNodeLocalBegin();
    const unsigned int nodeLocalEnd = m_uiMesh->getNodeLocalEnd();

    for (unsigned int node = nodeLocalBegin; node < nodeLocalEnd; node++) {
        enforce_{{ project_name }}_constraints(
            zipIn, node{{ ", m_preEnforceMin" if enforcement_monitors }});
    }

    return 0;
}

