def initial_data(id_type, x, y, z, p, **runtime):
    """Dispatch on ``id_type``, passing only the runtime values it asks for."""
    if id_type in INITIAL_DATA_UNAVAILABLE:
        raise NotImplementedError(
            f"id_type {id_type}: {INITIAL_DATA_UNAVAILABLE[id_type]}"
        )
    if id_type not in INITIAL_DATA:
        raise KeyError(
            f"id_type {id_type} is not one of {sorted(INITIAL_DATA)}"
        )
    _name, fn, needs = INITIAL_DATA[id_type]
    missing = [n for n in needs if n not in runtime]
    if missing:
        raise TypeError(f"id_type {id_type} ({_name}) needs {missing}")
    return fn(x, y, z, p, **{n: runtime[n] for n in needs})
