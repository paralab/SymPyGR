{% if jax_enforce %}

# --- constraint enforcement ------------------------------------------------
# Applied to the STATE between steps, not to the RHS. Names only: the algebra
# (det -> 1, trace removal, floors) is identical in every conformal
# formulation and belongs to the driver, not here.

#: Conformal metric, rescaled to det = 1. Symmetric 3x3 in (00,01,02,11,12,22).
METRIC_VARS = (
{% for name in jax_enforce.metric %}
    "{{ name }}",
{% endfor %}
)

#: Each made trace-free with respect to the renormalized metric. Same ordering.
TRACE_FREE_VARS = (
{% for group in jax_enforce.trace_free %}
    ({% for name in group %}"{{ name }}", {% endfor %}),
{% endfor %}
)

#: (variable, floor parameter). The driver supplies the value.
POS_FLOOR_VARS = (
{% for name, floor in jax_enforce.pos_floor %}
    ("{{ name }}", "{{ floor }}"),
{% endfor %}
)
