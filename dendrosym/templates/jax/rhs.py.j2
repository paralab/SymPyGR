"""{{ project_name }} RHS -- GENERATED by dendrosym. Do not edit.

Regenerate: python <config>.py <outdir> --emit=jax

Same SymPy source and CSE as the C++ backend, so DENDRO_n numbering matches it
statement for statement.

Entry points take (u, d, p) and return the outputs in declared order:
    u  fields by name, u["alpha"]
    d  derivatives by name, d["grad_0_alpha"], d["grad2_0_1_chi"]
    p  parameters by attribute, p.eta

Pure elementwise arithmetic closing over nothing -- any array shape works, and
it is safe to jit and vmap.
"""

import jax.numpy as jnp

{% for vt in jax_var_types %}
# --- {{ vt }} -------------------------------------------------------------
{{ vt|upper }}_OUTPUTS = (
{% for name in jax[vt].outputs %}
    "{{ name }}",
{% endfor %}
)

{{ vt|upper }}_FIELDS = (
{% for name in jax[vt].leaves.field %}
    "{{ name }}",
{% endfor %}
)

#: Every buffer the driver must fill -- the RHS body's, plus any the BC table
#: needs that the equations themselves do not. Mirrors the C++ `d` struct.
{{ vt|upper }}_DERIVS = (
{% for name in jax[vt].deriv_names %}
    "{{ name }}",
{% endfor %}
)

{{ vt|upper }}_PARAMS = (
{% for name in jax[vt].leaves.param %}
    "{{ name }}",
{% endfor %}
)
{% if jax_bcs.get(vt) %}

#: Sommerfeld rows: (rhs, field, grad_x, grad_y, grad_z, falloff, asymptotic).
#: Apply with dendrojax.derivs.compute_sommerfeld_bcs -- one row is its
#: (f, df_dx, df_dy, df_dz, ..., falloff, asymp) arguments.
{{ vt|upper }}_BCS = (
{% for rhs, field, grads, falloff, asymptotic in jax_bcs[vt] %}
    ("{{ rhs }}", "{{ field }}", "{{ grads[0] }}", "{{ grads[1] }}", "{{ grads[2] }}", {{ falloff|float }}, {{ asymptotic|float }}),
{% endfor %}
)
{% else %}

{{ vt|upper }}_BCS = ()
{% endif %}
{% if jax[vt].leaves.unknown %}

# Used by the equations but declared as neither field nor parameter; the caller
# must supply these in `u`.
{{ vt|upper }}_EXTRA_INPUTS = (
{% for name in jax[vt].leaves.unknown %}
    "{{ name }}",
{% endfor %}
)
{% else %}

{{ vt|upper }}_EXTRA_INPUTS = ()
{% endif %}


def {{ vt }}_rhs(u, d, p):
    """Returns {{ vt|upper }}_OUTPUTS, in order."""
    _u, _d, _p = u, d, p           # a field may be named u, d or p
{% for name in jax[vt].leaves.field %}
    {{ name }} = _u["{{ name }}"]
{% endfor %}
{% for name in jax[vt].leaves.unknown %}
    {{ name }} = _u["{{ name }}"]
{% endfor %}
{% for name in jax[vt].deriv_names %}
    {{ name }} = _d["{{ name }}"]
{% endfor %}
{% for name in jax[vt].leaves.param %}
    {{ name }} = _p.{{ name }}
{% endfor %}

{{ jax[vt].body }}

    return (
{% for name in jax[vt].outputs %}
        {{ name }},
{% endfor %}
    )

