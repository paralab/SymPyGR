[build-system]
requires = ["setuptools>=77.0"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project_name }}-jax"
version = "0.1.0"
description = "{{ project_name }} solver equations for DendroJAX, generated by dendrosym"
# 3.11 floor follows dendrojax: it imports stdlib tomllib (PEP 680) with no
# fallback, so 3.10 fails at `import dendrojax`.
requires-python = ">=3.11"

dependencies = [
  "dendrojax",
  "jax>=0.8.1,<0.10",
]

[project.optional-dependencies]
cuda13 = ["jax[cuda13]>=0.8.1,<0.10"]

[tool.setuptools]
packages = ["{{ project_name }}"]
